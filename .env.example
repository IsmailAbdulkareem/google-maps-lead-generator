GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACES_API_MODE=legacy
MAX_RESULTS_PER_SEARCH=5
WEBSITE_CHECK_TIMEOUT_MS=5000
GOOGLE_PLACES_API_MODE=auto

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# Clerk session lifetime (seconds). Default 86400 (24h). Increase if users get logged out.
# CLERK_SESSION_MAX_AGE=86400

MAX_SEARCHES_PER_DAY=5
MAX_LEADS_PER_DAY=25
MAX_AI_MESSAGES_PER_DAY=20

EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Groq AI (required for AI chat assistant)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase (required for cloud lead storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Admin email — gets unlimited searches/leads regardless of tier limits
ADMIN_EMAIL=your_email@example.com
